# ── P.Care Pharma — Backend Environment Variables
# Copy this to .env and fill real values. NEVER commit .env to git.

NODE_ENV=production
PORT=4000
APP_VERSION=1.0.0

# Supabase (from Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role key — backend only, never expose
SUPABASE_ANON_KEY=eyJ...             # anon key — safe for frontend

# Frontend URL (CORS allowlist)
FRONTEND_URL=https://pcarepharma.in

# Logging
LOG_LEVEL=info                       # debug | info | warn | error

# ── Module 23: AI supplier-invoice reading (OPTIONAL)
# Leave GEMINI_API_KEY unset and the rest of the app is unaffected — the
# invoice endpoints answer 503 EXTRACTION_UNAVAILABLE instead of the API
# refusing to boot. Key from https://aistudio.google.com/apikey.
# SERVER-SIDE ONLY. It must never appear in a frontend .env or a bundle.
GEMINI_API_KEY=
# gemini-2.5-flash was retired ("no longer available to new users") — pin the
# model explicitly and check https://ai.google.dev/gemini-api/docs/models if
# every upload starts failing identically with EXTRACTION_MODEL_UNAVAILABLE.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=120000             # a multi-page scan is a slow read
GEMINI_MAX_ATTEMPTS=2                # retries on 429/5xx only
GEMINI_MAX_OUTPUT_TOKENS=32768       # too low truncates a long invoice's JSON

# Private Supabase Storage bucket holding the original documents.
# Created by schema-23-supplier-invoices.sql; never make it public.
SUPABASE_INVOICE_BUCKET=supplier-invoices
INVOICE_MAX_UPLOAD_MB=12             # Gemini's inline ceiling is 20MB after base64
INVOICE_SIGNED_URL_TTL=900           # seconds a review-screen preview link lives

# ── Test credentials (required by backend/tests — leave unset in production)
# Without these, every test that logs in fails with INVALID_CREDENTIALS.
# Point them at real seeded Supabase users in a NON-production project.
TEST_OWNER_EMAIL=owner@pcare.test
TEST_OWNER_PASSWORD=
TEST_STAFF_EMAIL=staff@pcare.test
TEST_STAFF_PASSWORD=
